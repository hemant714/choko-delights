# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must NEVER be committed.
# On Vercel, add these same keys under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public site URL (used for absolute OG image / metadata). Optional.
# e.g. https://choko-delights.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── Google Sheets (lead capture) ──
# Service account email, e.g. choko-leads@my-project.iam.gserviceaccount.com
GOOGLE_SHEETS_CLIENT_EMAIL=

# Service account private key. Keep it on ONE line and wrap in quotes.
# Replace real line breaks with \n (they are converted back in code).
# e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_PRIVATE_KEY=

# The spreadsheet ID from its URL:
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Worksheet/tab name to append rows to. Optional (defaults to "Leads").
GOOGLE_SHEETS_TAB=Leads
